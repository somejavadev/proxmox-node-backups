# Copy this file to /etc/pve-node-backup.env and fill in real values.
# chmod 600 /etc/pve-node-backup.env  (root-only, contains a secret)

PBS_REPOSITORY=user@pbs!tokenname@pbs.example.com:datastore-name
PBS_PASSWORD=your-api-token-secret-here

# Optional: only needed if PBS uses a self-signed certificate and the
# fingerprint isn't already trusted/pinned on this host.
# PBS_FINGERPRINT=xx:xx:xx:...
